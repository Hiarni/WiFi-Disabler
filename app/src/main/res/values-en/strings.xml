    <!-- Status -->
    <string name="status_active">Active</string>
    <plurals name="status_active_desc">
        <item quantity="one">Watching %d network</item>
        <item quantity="other">Watching %d networks</item>
    </plurals>
    <string name="status_limited">Setup incomplete</string>
    <string name="status_limited_desc">Network names can\'t be read yet – see below.</string>
