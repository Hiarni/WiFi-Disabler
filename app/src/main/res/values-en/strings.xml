    <string name="tile_no_networks">No networks</string>

    <!-- Notifications -->
    <string name="channel_service_name">Background service</string>
    <string name="channel_service_desc">Silent notification required by Android while reliable mode is on.</string>
    <string name="channel_events_name">Switch-off notices</string>
    <string name="channel_events_desc">Shown when Wi-Fi was turned off or could not be turned off.</string>
    <string name="service_notification_title">Watching Wi-Fi connections</string>
