    <string name="status_paused_desc">Wi-Fi is left alone.</string>
    <string name="status_empty">No networks yet</string>
    <string name="status_empty_desc">Add a network below to get started.</string>

    <!-- Setup -->
    <string name="setup_title">Setup</string>
    <string name="setup_desc">Android only reveals Wi-Fi network names to apps with location access. Your location is never read or stored.</string>
    <string name="setup_location_title">Location access: always</string>
    <string name="setup_location_desc">Needed to read the network name.</string>
    <string name="setup_location_background_desc">Choose “Allow all the time” so it also works in the background.</string>
    <string name="setup_location_service_title">Location turned on</string>
    <string name="setup_location_service_desc">Without it, Android hides network names from all apps.</string>

    <!-- Reliability -->
    <string name="reliability_title">Reliability</string>
    <string name="reliability_desc">Some systems stop background apps. These optional steps prevent that.</string>
    <string name="reliability_battery_title">No battery restrictions</string>
    <string name="reliability_battery_desc">Lets the app react while the device is idle.</string>
    <string name="reliability_autostart_title">Allow autostart</string>
    <string name="reliability_autostart_desc">This device blocks background apps until autostart is allowed.</string>

    <!-- Networks -->
    <string name="networks_title">Networks</string>
    <string name="networks_desc">Wi-Fi is switched off as soon as the device connects to one of these networks.</string>
    <string name="networks_add_current">Add “%1$s”</string>
    <string name="networks_input_label">Network name (SSID)</string>
    <string name="networks_input_invalid">Not a valid network name (max. 32 characters).</string>
    <string name="networks_empty">No networks added.</string>
    <plurals name="networks_count">
        <item quantity="one">%d network</item>
        <item quantity="other">%d networks</item>
    </plurals>

    <!-- Options -->
    <string name="options_title">Options</string>
    <string name="option_reliable_title">Reliable mode</string>
    <string name="option_reliable_desc">Keeps a silent background service running. Only needed if the system stops the app.</string>
    <string name="option_reliable_hide_notification">Hide notification</string>
    <string name="option_notify_title">Notify on switch-off</string>
    <string name="option_notify_desc">Shows a silent notification when Wi-Fi was turned off. Failures are always reported.</string>

    <!-- History -->
    <string name="history_title">Recent activity</string>
    <string name="history_success">Wi-Fi turned off</string>
